# Cursor styling
cursor-style = "block"
cursor-style-blink = false

# Cursor styling + SSH session terminfo
# (all shell integration options must be passed together)
shell-integration-features = no-cursor,ssh-env

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95

# font
font-family = "Berkeley Mono"

# shaders
custom-shader = ~/.config/ghostty/shaders/cursor-smear.glsl
custom-shader = ~/.config/ghostty/shaders/tft.glsl
custom-shader = ~/.config/ghostty/shaders/crt.glsl
# custom-shader = ~/.config/ghostty/shaders/bloom.glsl
